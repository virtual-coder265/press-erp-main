# Gov Press ERP — production environment template
# Deploy: copy to .env on the server and replace every CHANGE_ME value.
# Do not commit the live .env file with real secrets.

# --- Application ---
APP_ENV=production
APP_NAME="Gov Press ERP"
APP_TIMEZONE=Africa/Blantyre
BASE_URL=https://press.xlabmw.com/
MAINTENANCE_MODE=false
ERP_OPERATION_MODE=pro

# --- Database (use a dedicated least-privilege user, not root) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=press_erp
DB_USER=press_erp_app
DB_PASS=CHANGE_ME_STRONG_DB_PASSWORD

# --- Installation lock ---
APP_INSTALLED=true
INSTALLER_REENTRY_TOKEN=
INSTALLER_PREVIOUS_MAINTENANCE_MODE=false
INSTALLER_LAST_SQL_FILE=full_prod_db_april_10.sql
INSTALLER_LAST_MODE=manual
INSTALLER_LAST_INSTALLED_AT=

# --- Cron HTTP trigger (optional; prefer CLI cron only) ---
# Generate: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Leave empty to disallow HTTP cron URLs entirely.
CRON_HTTP_SECRET=365bd0ae82f989944a707211f6e0f0693b2b748e8d901f7b55e979ed62304a3a

# --- Mail (SMTP) ---
MAIL_DRIVER=smtp
MAIL_HOST=CHANGE_ME_SMTP_HOST
MAIL_PORT=465
MAIL_USERNAME=CHANGE_ME_SMTP_USER
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Gov Press ERP"
MAIL_QUEUE_ENABLED=true
MAIL_LOG_ENABLED=true

# --- SMS / WhatsApp (Twilio) ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# --- API / webhooks ---
API_CLIENT_ID=
API_CLIENT_SECRET=
WEBHOOK_ENDPOINT=
WEBHOOK_SIGNING_SECRET=

# --- Web push (VAPID) ---
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# --- AI ---
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
AI_MONTHLY_BUDGET=0
AI_MAX_TOKENS=700
AI_TIMEOUT_SECONDS=30
AI_ENABLE_TASKS=true
AI_ENABLE_PROJECTS=true
AI_ENABLE_REMINDERS=true
AI_ENABLE_ANALYSIS=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
