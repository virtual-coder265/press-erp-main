<?php
require_once __DIR__ . '/../../config/app.php';
checkAuth();
require_once __DIR__ . '/../../config/database.php';
require_once __DIR__ . '/../../includes/reminder_helper.php';

$userId = (int) ($_SESSION['user_id'] ?? 0);
$view = trim((string) ($_GET['view'] ?? 'active'));
$sourceFilter = trim((string) ($_GET['source'] ?? 'all'));
$search = trim((string) ($_GET['search'] ?? ''));
$editReminderId = (int) ($_GET['edit'] ?? 0);

$hub = trim((string) ($_GET['hub'] ?? 'board'));
if (!in_array($hub, ['board', 'calendar'], true)) {
    $hub = 'board';
}

$calMonth = trim((string) ($_GET['cal_month'] ?? ''));
if (!preg_match('/^\d{4}-\d{2}$/', $calMonth)) {
    $calMonth = date('Y-m');
}
$calendarStart = $calMonth . '-01';
$calendarEnd = date('Y-m-t', strtotime($calendarStart));
$calDayRaw = trim((string) ($_GET['cal_day'] ?? ''));
$todayYmd = date('Y-m-d');
$selectedDay = $calDayRaw;
if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $selectedDay)) {
    $selectedDay = ($todayYmd >= $calendarStart && $todayYmd <= $calendarEnd) ? $todayYmd : $calendarStart;
} elseif ($selectedDay < $calendarStart || $selectedDay > $calendarEnd) {
    $selectedDay = max($calendarStart, min($selectedDay, $calendarEnd));
}

if (!in_array($view, ['active', 'all', 'completed', 'dismissed'], true)) {
    $view = 'active';
}

if (!in_array($sourceFilter, ['all', 'self', 'task_assignment'], true)) {
    $sourceFilter = 'all';
}

$moduleReady = reminder_module_ready($pdo, true);
$stats = [
    'active' => 0,
    'due_today' => 0,
    'overdue' => 0,
    'task_linked' => 0,
    'personal' => 0,
    'completed' => 0,
    'dismissed' => 0,
];
$reminders = [];
$taskLinkedCards = [];
$personalCards = [];
$spotlightCards = [];
$resolvedCards = [];
$editReminder = null;
$editReminderRemindAtValue = '';
$editReminderAlarmEnabled = 1;
$editReminderAlarmOffsetMinutes = 30;
$alarmOffsetOptions = reminder_alarm_offset_options();

$calendarRows = [];
$calendarByDay = [];
$weekByDay = [];
$weekStart = date('Y-m-d', strtotime('monday this week'));
$weekEnd = date('Y-m-d', strtotime('sunday this week'));
$upcomingAlarms = [];
$alarmActiveCount = 0;

if ($moduleReady) {
    backfill_task_assignment_reminders_for_user($pdo, $userId);
    $stats = fetch_reminder_counts_for_user($pdo, $userId);
    $reminders = fetch_reminders_for_user($pdo, $userId, [
        'status' => $view,
        'source' => $sourceFilter,
        'search' => $search,
        'limit' => $view === 'all' ? 120 : 80,
    ]);

    foreach ($reminders as $reminder) {
        if (($reminder['status'] ?? 'active') === 'active' && in_array(($reminder['due_meta']['tone'] ?? ''), ['danger', 'warning'], true)) {
            $spotlightCards[] = $reminder;
        }

        if (($reminder['source'] ?? 'self') === 'task_assignment') {
            $taskLinkedCards[] = $reminder;
        } else {
            $personalCards[] = $reminder;
        }

        if (($reminder['status'] ?? 'active') !== 'active') {
            $resolvedCards[] = $reminder;
        }
    }

    if ($editReminderId > 0) {
        $editReminder = fetch_personal_reminder($pdo, $userId, $editReminderId);
        if ($editReminder) {
            $editReminderFallbackDatetime = !empty($editReminder['remind_at'])
                ? $editReminder['remind_at']
                : (!empty($editReminder['due_on']) ? ($editReminder['due_on'] . ' 09:00:00') : null);
            $editReminderRemindAtValue = format_reminder_datetime_local($editReminderFallbackDatetime);
            $editReminderAlarmEnabled = isset($editReminder['alarm_enabled']) ? (int) $editReminder['alarm_enabled'] : 1;
            $editReminderAlarmOffsetMinutes = isset($editReminder['alarm_offset_minutes'])
                ? (int) $editReminder['alarm_offset_minutes']
                : 30;
        }
    }

    if ($hub === 'calendar') {
        $calendarRows = fetch_reminders_for_calendar_range($pdo, $userId, $calendarStart, $calendarEnd, [
            'status' => 'active',
            'source' => $sourceFilter,
            'search' => $search,
        ]);
        $calendarByDay = group_reminders_by_calendar_day($calendarRows);

        $weekRows = fetch_reminders_for_calendar_range($pdo, $userId, $weekStart, $weekEnd, [
            'status' => 'active',
            'source' => $sourceFilter,
            'search' => $search,
        ]);
        $weekByDay = group_reminders_by_calendar_day($weekRows);

        $upcomingAlarms = fetch_upcoming_alarm_schedule($pdo, $userId, 20);
        $alarmActiveCount = count_scheduled_active_alarms($pdo, $userId);
    }
}

$success = trim((string) ($_GET['success'] ?? ''));
$error = trim((string) ($_GET['error'] ?? ''));
$redirectQuery = http_build_query(array_filter([
    'hub' => $hub !== 'board' ? $hub : null,
    'cal_month' => $hub === 'calendar' ? $calMonth : null,
    'cal_day' => $hub === 'calendar' ? $selectedDay : null,
    'view' => $view !== 'active' ? $view : null,
    'source' => $sourceFilter !== 'all' ? $sourceFilter : null,
    'search' => $search !== '' ? $search : null,
]));
$redirectTarget = 'modules/reminders/index' . ($redirectQuery !== '' ? '?' . $redirectQuery : '');

include '../../includes/header.php';
?>

