<script>
document.addEventListener('DOMContentLoaded', function() {
    const reminderFilterForm = document.getElementById('reminderFilterForm');
    if (!reminderFilterForm) {
        return;
    }

    reminderFilterForm.addEventListener('change', function(event) {
        const target = event.target;
        if (!target || (target.name !== 'view' && target.name !== 'source')) {
            return;
        }

        reminderFilterForm.submit();
    });
});
</script>

<?php include '../../includes/footer.php'; ?>
